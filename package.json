{
  "name": "petbsi-scrum",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestão ágil do projeto PETBSI (Next.js, PostgreSQL e autenticação Google)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:provision-role": "tsx scripts/provision-neon-runtime.ts",
    "db:bootstrap": "tsx scripts/bootstrap-data.ts core",
    "db:invite": "tsx scripts/bootstrap-data.ts invite"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
