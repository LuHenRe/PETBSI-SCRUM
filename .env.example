# Copie para .env.local. Preencha somente na sua máquina ou no gerenciador de segredos do ambiente.
# Aplicação: papel PostgreSQL com SELECT/INSERT/UPDATE estritamente necessários, sem DDL.
DATABASE_URL="postgresql://APP_ROLE:SECRET@EP-POOLER.neon.tech/petbsi?sslmode=require"
# Migrações e bootstrap: papel separado, URL direta (sem -pooler). Nunca configurar na Vercel runtime.
MIGRATION_DATABASE_URL="postgresql://MIGRATION_ROLE:SECRET@EP.neon.tech/petbsi?sslmode=require"
AUTH_SECRET="GENERATE_A_RANDOM_SECRET_PER_ENVIRONMENT"
AUTH_GOOGLE_ID="GOOGLE_OAUTH_CLIENT_ID"
AUTH_GOOGLE_SECRET="GOOGLE_OAUTH_CLIENT_SECRET"
AUTH_URL="http://localhost:3000"
